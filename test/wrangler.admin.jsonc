// The admin Worker as the browser check runs it: admin/wrangler.jsonc on the test database.
{
  "name": "talkhalifax-admin-test",
  "main": "../admin/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../admin/public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "talkhalifax-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../migrations" }
  ],
  "vars": { "ADMIN_DEV": "1" }
}
