{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talkhalifax",
  // The editor's Cloudflare account. Pinned so deploys (local or from GitHub) can't land on another account.
  "account_id": "5b365e1eb102c26b07e110dae02fbfa9",
  "main": "src/index.ts",
  // newsroom/guidelines.md is bundled as text so agents can read it through the MCP get_guidelines tool
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The page and its assets. The Worker runs first so /api, /auth and /rooms never fall through to files.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  // Stories, users, sessions, weather and per-room stats.
  "d1_databases": [
    { "binding": "DB", "database_name": "talkhalifax", "database_id": "11e74fb3-39eb-42ac-9f0b-620d5c3d47d2", "migrations_dir": "migrations" }
  ],

  // One ArticleRoom per story: live chat history, connections, presence and typing.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ArticleRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArticleRoom"] }],

  // Workers AI screens chat messages and comments (Llama Guard) before they post.
  "ai": { "binding": "AI" },

  // Weather, weather warnings, the events check, story stages and clean-up every 30 minutes.
  "triggers": { "crons": ["*/30 * * * *"] },

  "vars": {
    // Comma-separated usernames that get the moderator role (for Google sign-in, the ADMIN_EMAILS secret).
    "ADMIN_USERNAMES": "admin",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF2Lk62vgkTC9ISs"
  },
  "observability": { "enabled": true }
}
